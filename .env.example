# ==============================================================================
# E-COMMERCE MICROSERVICES PLATFORM ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env before starting the services with docker-compose.
#
# Production Note: Change all default passwords and secrets in production environments!

# ------------------------------------------------------------------------------
# General & Application Environment
# ------------------------------------------------------------------------------
NODE_ENV=production
APP_VERSION=1.0.0

# ------------------------------------------------------------------------------
# Security & Authentication
# ------------------------------------------------------------------------------
# Shared JWT secret key between api-gateway (token validation) and auth-service (token signing)
JWT_SECRET=super-secret-jwt-key-change-in-production
JWT_EXPIRATION=3600s

# ------------------------------------------------------------------------------
# Service Ports (Host:Container)
# ------------------------------------------------------------------------------
API_GATEWAY_PORT=3000
AUTH_SERVICE_PORT=3001
ORDER_SERVICE_PORT=3002
INVENTORY_SERVICE_PORT=3003
NOTIFICATION_SERVICE_PORT=3004

# ------------------------------------------------------------------------------
# Database (MySQL 8.0) Configuration
# ------------------------------------------------------------------------------
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=ecommerce
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_USER=ecommerce_user
MYSQL_PASSWORD=ecommerce_password

# ------------------------------------------------------------------------------
# Cache (Redis 7) Configuration
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# ------------------------------------------------------------------------------
# Message Broker (RabbitMQ 3) Configuration
# ------------------------------------------------------------------------------
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672

# ------------------------------------------------------------------------------
# Internal Service Discovery URLs (Docker Network)
# ------------------------------------------------------------------------------
AUTH_SERVICE_URL=http://auth-service:3001
ORDER_SERVICE_URL=http://order-service:3002
INVENTORY_SERVICE_URL=http://inventory-service:3003
NOTIFICATION_SERVICE_URL=http://notification-service:3004
